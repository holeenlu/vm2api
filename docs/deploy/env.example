# copy to /etc/tapmodels.env  (chmod 600)
# TAPMODELS_* wins; KIN_* is fallback.
#
# 未配置时一键脚本 / 容器入口只填空字段：管理台 admin / 每次安装生成的随机密码。

TAPMODELS_API_KEY=
TAPMODELS_ADMIN_USER=admin
TAPMODELS_ADMIN_PASSWORD=
TAPMODELS_DB_SECRET=

PORT=8787
HOST=0.0.0.0
# Maximum silence while a client uploads a request body. 0 disables this
# application-level body timeout; model response timeouts are separate.
KIN_REQUEST_BODY_TIMEOUT_MS=120000
# PUBLIC_BASE_URL=https://example.com
# 管理台静态站点与 API 不同源时，列出允许带 Cookie 跨源访问的 Origin（空格或逗号分隔）。
# PANEL_CORS_ORIGINS=https://panel.example.com
# GITHUB_TOKEN=          # 可选。面板查 GitHub Release 提高限额；也可用 TAPMODELS_GITHUB_TOKEN
# TAPMODELS_CLUSTER_SOCKET_DIR=  # 可选。集群 Docker 桥 socket 目录，默认 $KIN_DATA_DIR/cluster；数据目录不支持 unix socket 时改到本地文件系统

KIN_PROJECT_ROOT=/opt/tapmodels
KIN_DATA_DIR=/opt/tapmodels/data
KIN_KERNEL_BIN=/opt/tapmodels/bin/kin-kernel
KIN_EGRESS_BIN=/opt/tapmodels/bin/kin-egress
KIN_WORKER_BIN=/opt/tapmodels/bin/kin-worker
