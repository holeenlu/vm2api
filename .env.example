# copy to .env  (chmod 600). Used by docker compose and local node.
# TAPMODELS_* wins; KIN_* is fallback.
#
# 未配置时一键脚本 / 容器入口会只填空字段：
#   管理台 admin / 每次安装生成的随机密码（已有密码不覆盖）
#   TAPMODELS_API_KEY / TAPMODELS_DB_SECRET 为空则生成随机 hex

TAPMODELS_API_KEY=
TAPMODELS_ADMIN_USER=admin
TAPMODELS_ADMIN_PASSWORD=
TAPMODELS_DB_SECRET=

# Codex Gateway Worker. HTTP+HMAC is intended for loopback only. Codex requests use the Worker only
# for groups bound to Gateway accounts; other groups keep the Codex VM path.
# 控制面读取 SUPERVISE / INTERNAL_TOKEN / CREDENTIAL_BUNDLE_KEY / ALLOW_INSECURE；其余键由 kin-codex-gateway
# 进程读取（托管时随控制面环境传入）。启动方式见 docs/CODEX_GATEWAY_WORKER_SETUP.md。
# Worker 只支持与控制面同机的单个实例（直读控制面数据库）：已有在线接单实例时拒绝另一个实例注册。
# 默认由控制面托管同机的一个 Worker（bin/kin-codex-gateway 存在时自动启动、崩溃重启、随升级换版本）。
# 设为 0 表示同机 Worker 由外部管理（scripts/codex-gateway-start.sh 或 systemd）。
KIN_CODEX_GATEWAY_SUPERVISE=

# 控制面与 Worker 共用的内部 HMAC token：openssl rand -hex 32。留空时控制面生成并保存在
# data/runtime-secrets.json（托管 Worker 自动使用）；外部管理的 Worker 需要在两侧显式写同一个值。
KIN_CODEX_GATEWAY_INTERNAL_TOKEN=
# Credential bundle key shared by the control plane and the Worker (exports and refresh reports).
# Never reuse the control-plane HMAC token for this purpose. openssl rand -hex 32
KIN_CODEX_GATEWAY_CREDENTIAL_BUNDLE_KEY=

# Worker 进程身份、监听与控制面可达地址。
KIN_CODEX_GATEWAY_INSTANCE_ID=gw-01
KIN_CODEX_GATEWAY_LISTEN=127.0.0.1:8790
KIN_CODEX_GATEWAY_ADVERTISE_URL=http://127.0.0.1:8790
KIN_CODEX_GATEWAY_REGION=
# 留空＝$KIN_PROJECT_ROOT/data/codex-gateway（账号凭据与 Receipt spool 落在这里）
KIN_CODEX_GATEWAY_DATA_DIR=

# Worker 主动回连控制面：注册/心跳与 Receipt 回调。端口随本文件的 PORT。
KIN_CODEX_GATEWAY_CONTROL_PLANE_URL=http://127.0.0.1:8787/internal/v1/gateway/workers/register
KIN_CODEX_GATEWAY_RECEIPT_URL=http://127.0.0.1:8787/internal/v1/gateway/receipts

# 进程总并发与单账号并发上限；账号自身的并发/RPM 仍由账号配置另行约束。
KIN_CODEX_GATEWAY_MAX_CONCURRENCY=64
KIN_CODEX_GATEWAY_ACCOUNT_CONCURRENCY=4
KIN_CODEX_GATEWAY_REQUEST_TIMEOUT_SECONDS=900

# 留空＝Node 与 Go 两侧都只接受环回明文 + HMAC；同机的私有主机网络地址才需要设为 1。
KIN_CODEX_GATEWAY_ALLOW_INSECURE=

# 统一控制面开关（控制面读取，改后重启控制面；留空＝默认）。说明与上线顺序见 docs/CODEX_GATEWAY_WORKER_SETUP.md 第 8–12 节。
# 执行事件发件箱：off（默认）/ shadow / primary
KIN_EXECUTOR_EVENTS=
# 刷新令牌租约与控制面凭据托管自 2026-11-06 起恒定启用，不再有开关（KIN_REFRESH_LEASE、KIN_CREDENTIAL_CUSTODY 已移除）。
# 凭据库主密钥文件；留空＝数据库同目录的 credential-master-keys.json。必须与数据库分开备份，面板备份不含它。
KIN_CREDENTIAL_MASTER_KEY_FILE=
# 多 Worker 共享运行态（由 Worker 读取，托管 Worker 继承这里的值）：redis://[:密码@]主机:端口/库号，跨主机用 rediss://。见第 13 节。
KIN_REDIS_URL=
# Redis 键前缀，留空＝kin:gw:；多套部署共用一个 Redis 时设成不同值。
KIN_REDIS_PREFIX=

PORT=8787
HOST=0.0.0.0
# Maximum silence while a client uploads a request body. 0 disables this
# application-level body timeout; model response timeouts are separate.
KIN_REQUEST_BODY_TIMEOUT_MS=120000
# HOST 仅监听；/health、/v1/meta 的 base_url 需配置 PUBLIC_BASE_URL 或 PUBLIC_HOST（勿把 0.0.0.0 当对外地址）
# 前面有 nginx 等反代时设 HOST=127.0.0.1：控制面只在环回口可达，不再随公网 IP 暴露 PORT。
# 槽位与控制面走 unix socket，集群为控制面主动外连，都不依赖该端口的公网监听。
# PUBLIC_BASE_URL=https://example.com
# PUBLIC_HOST=127.0.0.1
# GITHUB_TOKEN=          # 可选。面板查 GitHub Release 提高限额；也可用 TAPMODELS_GITHUB_TOKEN
