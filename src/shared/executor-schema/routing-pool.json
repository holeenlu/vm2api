{
  "version": 1,
  "scope": "routing",
  "description": "routing.json 调度段（pool、sticky、quota、concurrency、failover）的字段、类型与范围。控制面保存时按本描述校验，未知键与非法值返回 400 invalid_routing_config；加载时非法值回到 default（没有 default 的字段删除，由使用方取内置默认），超出范围的数值截断，同一问题只告警一次。见 docs/ROUTING_CONFIG.md。",
  "sections": ["pool", "sticky", "quota", "concurrency", "failover"],
  "fields": [
    { "key": "pool.strategy", "type": "enum", "values": ["balanced", "fill"], "default": "balanced" },
    { "key": "pool.queue_max", "type": "integer", "min": 1, "max": 999, "default": 50 },
    {
      "key": "pool.seat_grace_ms",
      "type": "integer",
      "min": 0,
      "max": 120000,
      "default": 30000,
      "note": "上游原有字段：可保存，但席位规划当前不使用（pool-scheduler 传 0，seat-planner 注明 unused）"
    },
    { "key": "pool.seat_budget_reserve_pct", "type": "number", "min": 0, "max": 0.5, "default": 0.02 },
    { "key": "pool.fallback_wait_timeout_ms", "type": "integer", "min": 1000, "max": 120000, "default": 30000 },
    { "key": "pool.sticky_wait_timeout_ms", "type": "integer", "min": 1000, "max": 120000, "default": 45000 },
    { "key": "pool.circuit_failure_threshold", "type": "integer", "min": 1, "max": 20, "default": 3 },
    { "key": "pool.circuit_open_ms", "type": "integer", "min": 1000, "max": 3600000, "default": 30000 },
    { "key": "pool.worker_health_ttl_ms", "type": "integer", "min": 1000, "max": 60000, "default": 5000 },
    {
      "key": "pool.heartbeat_stale_ms",
      "type": "integer",
      "min": 1000,
      "max": 600000,
      "default": 15000,
      "note": "随默认 routing.json 发布，当前没有读取方"
    },
    { "key": "sticky.enabled", "type": "boolean", "default": true },
    { "key": "sticky.mode", "type": "enum", "values": ["conversation", "session", "ip"], "default": "conversation" },
    { "key": "sticky.ttl_seconds", "type": "integer", "min": 60, "max": 2592000, "default": 86400 },
    { "key": "sticky.header_keys", "type": "string_list", "max_items": 32, "max_length": 128 },
    { "key": "sticky.body_keys", "type": "string_list", "max_items": 32, "max_length": 128 },
    { "key": "sticky.outbound_session", "type": "enum", "values": ["rebuild", "passthrough"], "default": "rebuild" },
    { "key": "quota.safety_ratio", "type": "number", "min": 0, "max": 1, "default": 0.85 },
    { "key": "quota.weekly_safety_ratio", "type": "number", "min": 0, "max": 1, "default": 0.8 },
    { "key": "quota.warn_ratio", "type": "number", "min": 0, "max": 1, "default": 0.75 },
    { "key": "quota.block_on_5h", "type": "boolean", "default": true },
    { "key": "quota.block_on_7d", "type": "boolean", "default": true },
    { "key": "quota.critical_band", "type": "number", "min": 0.01, "max": 0.15, "default": 0.05 },
    { "key": "quota.gate_overshoot", "type": "number", "min": 0, "max": 0.1, "default": 0.05 },
    { "key": "quota.large_cold_uncached_tokens", "type": "integer", "min": 20000, "max": 500000, "default": 100000 },
    { "key": "quota.guard_large_cold", "type": "boolean", "default": true },
    { "key": "quota.weekly_split.enabled", "type": "boolean", "default": false },
    { "key": "quota.weekly_split.fable_share", "type": "number", "min": 0, "max": 1, "default": 0.5 },
    { "key": "concurrency.default_max_per_account", "type": "integer", "min": 0, "max": 256, "default": 2 },
    { "key": "concurrency.default_key_concurrency", "type": "integer", "min": 0, "max": 256, "default": 2 },
    { "key": "concurrency.fable_max_per_account", "type": "integer", "min": 0, "max": 256, "default": 4 },
    { "key": "concurrency.default_max_rpm", "type": "integer", "min": 0, "max": 1000000, "default": 0 },
    { "key": "failover.max_total_attempts", "type": "integer", "min": 1, "max": 50, "default": 12 },
    { "key": "failover.max_account_switches", "type": "integer", "min": 0, "max": 50, "default": 10 },
    { "key": "failover.max_same_account_retries", "type": "integer", "min": 0, "max": 5, "default": 1 },
    { "key": "failover.same_account_retry_delay_ms", "type": "integer", "min": 0, "max": 5000, "default": 500 },
    { "key": "failover.same_account_retry_max_hop_ms", "type": "integer", "min": 0, "max": 30000, "default": 10000 },
    { "key": "failover.total_retry_deadline_ms", "type": "integer", "min": 10000, "max": 600000, "default": 120000 },
    { "key": "failover.oauth_401_cooldown_ms", "type": "integer", "min": 5000, "max": 600000, "default": 120000 },
    { "key": "failover.stream_idle_timeout_ms", "type": "integer", "min": 30000, "max": 3600000, "default": 180000 },
    { "key": "failover.queue_keepalive_delay_ms", "type": "integer", "min": 0, "max": 90000, "default": 60000 },
    { "key": "failover.session_queue_timeout_ms", "type": "integer", "min": 0, "max": 3600000, "default": 900000 },
    { "key": "failover.max_request_mib", "type": "integer", "min": 8, "max": 128, "default": 32 },
    { "key": "failover.stream_keepalive_ms", "type": "integer", "min": 1000, "max": 120000 },
    { "key": "failover.max_attempts", "type": "integer", "min": 1, "max": 1000 },
    { "key": "failover.max_switches", "type": "integer", "min": 1, "max": 1000 },
    { "key": "failover.eager_tool_streaming", "type": "boolean", "default": true },
    { "key": "failover.signature_repair", "type": "boolean", "default": false },
    { "key": "failover.delivery_mode", "type": "enum", "values": ["realtime", "verified"], "default": "realtime" }
  ]
}
