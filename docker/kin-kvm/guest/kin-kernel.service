[Unit]
Description=kin-kernel gateway worker
After=kin-guest-setup.service
Requires=kin-guest-setup.service

[Service]
User=kincli
RuntimeDirectory=kin-guest
RuntimeDirectoryMode=0770
EnvironmentFile=-/run/kin-guest/slot.env
Environment=HOME=/home/kincli
Environment=CLAUDE_CONFIG_DIR=/home/kincli/.claude
Environment=KIN_SUBMIT_WAIT_MS=30000
# #681: run payload binaries from guest-local copies, refreshed before every start
# ('+' = as root; '-' = a failed refresh keeps the previous copies and still starts).
ExecStartPre=-+/usr/local/sbin/kin-guest-setup payload
ExecStart=/usr/local/sbin/kin-kernel-start
Restart=always
RestartSec=2
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
